{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build gbDemo (Debug x64)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\gbScripts\\build-gbDemo.ps1",
                "-Configuration",
                "debug-client",
                "-Platform",
                "x64"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        }
    ]
}
